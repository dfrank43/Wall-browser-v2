{
  "name": "frameless-browser",
  "version": "1.3.4",
  "private": true,
  "description": "Cross-platform frameless Chromium video-wall browser for macOS and Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.local.framelessbrowser",
    "productName": "Frameless Browser",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "files": [
      "main.js",
      "collision.js",
      "preload.js",
      "shell.html",
      "site-preload.js",
      "package.json",
      "presets.html",
      "presets-preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
