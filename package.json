{
  "name": "frameless-browser",
  "version": "1.2.0",
  "private": true,
  "description": "Frameless multi-window Chromium browser for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.local.framelessbrowser",
    "productName": "Frameless Browser",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "files": [
      "main.js",
      "collision.js",
      "preload.js",
      "shell.html",
      "site-preload.js",
      "package.json"
    ]
  }
}
